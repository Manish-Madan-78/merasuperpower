---
interface Props { post: any; index: number; }
const { post, index } = Astro.props;
const { title, category, image, date } = post.data;
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const mins = Math.max(1, Math.round(words / 220));
const dateStr = date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<a class="post-card" href={`/blog/${post.id}/`} data-cat={category}>
  <div class:list={['thumb', !image && `tint-${index % 4}`]}>
    {image ? <img src={image} alt="" loading="lazy"> : <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6B5A45" stroke-width="1.3" aria-hidden="true"><path d="M12 4l2.2 4.6 5 .6-3.7 3.4 1 5-4.5-2.5-4.5 2.5 1-5L4.8 9.2l5-.6z"></path></svg>}
  </div>
  <span class="cat">{category}</span>
  <h3>{title}</h3>
  <span class="meta">{dateStr} · {mins} min read</span>
</a>
