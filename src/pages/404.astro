---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap page-head" style="padding-block:120px">
    <p class="eyebrow" style="margin:0">404</p>
    <h1>This page went missing.</h1>
    <p class="lede">Let's get you back on track.</p>
    <div class="actions"><a href="/" class="btn btn-accent">Go home</a><a href="/blog/" class="btn btn-outline">Read the blog</a></div>
  </section>
</Base>
